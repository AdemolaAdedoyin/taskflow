NODE_ENV=production
PORT=4000

# Managed PostgreSQL and Redis connection strings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Named API clients. Use independent 32+ character random secrets.
TASKFLOW_API_CLIENTS=writer:REPLACE_WITH_LONG_RANDOM_SECRET:jobs.read|jobs.write,ops:REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET:operations.read

LOG_LEVEL=info
JOB_CONCURRENCY=10
JOB_DEFAULT_TIMEOUT_MS=30000
HANDLER_CONCURRENCY_LIMITS=http_request:2
HANDLER_RATE_LIMITS=http_request:30/60000
HANDLER_LIMIT_RETRY_DELAY_MS=250
HANDLER_PERMIT_TTL_MS=60000

# Browser access is optional for this backend-only service.
CORS_ORIGINS=
TRUST_PROXY_HOPS=1
API_RATE_LIMIT_REQUESTS=600
API_RATE_LIMIT_WINDOW_MS=60000

# Keep outbound destinations narrow in production.
HTTP_ALLOWED_HOSTS=api.example.com
CALLBACK_ALLOWED_HOSTS=hooks.example.com
CALLBACK_SIGNING_SECRET=REPLACE_WITH_LONG_RANDOM_CALLBACK_SECRET
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_TIMEOUT_MS=10000
CALLBACK_CONCURRENCY=5
