NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://taskflow:taskflow@localhost:5432/taskflow
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info

JOB_CONCURRENCY=10
JOB_DEFAULT_TIMEOUT_MS=30000

# Optional distributed limits applied before a handler starts. Leave empty for
# no per-handler override. Formats:
#   HANDLER_CONCURRENCY_LIMITS=http_request:2,simulate_failure:4
#   HANDLER_RATE_LIMITS=http_request:30/60000,simulate_failure:60/60000
# where rate values are max/windowMs. Throttled jobs are delayed without using
# a business retry attempt or creating a JobExecution row.
HANDLER_CONCURRENCY_LIMITS=
HANDLER_RATE_LIMITS=
HANDLER_LIMIT_RETRY_DELAY_MS=250
HANDLER_PERMIT_TTL_MS=60000

# Scoped API clients. Format:
#   clientId:secret:scope|scope,clientId2:secret2:scope
# Bearer tokens are sent as <clientId>.<secret>.
# Allowed scopes: jobs.read, jobs.write, operations.read, *
# Production requires at least one client and secrets of at least 32 characters.
TASKFLOW_API_CLIENTS=writer:dev-writer-secret:jobs.read|jobs.write,operator:dev-operator-secret:operations.read

# Local/test compatibility only. Production ignores this shared legacy key.
TASKFLOW_API_KEY=changeme-local-only

# Comma-separated browser origins allowed to call the API. Empty disables
# cross-origin browser access while server-to-server and same-origin calls work.
CORS_ORIGINS=http://localhost:5173

# Exact hostnames permitted for http_request jobs. In production, an empty list
# disables outbound HTTP jobs. Keep this limited to endpoints you control/trust.
HTTP_ALLOWED_HOSTS=

# Optional completion callbacks are delivered by a separate BullMQ queue. In
# production, callbacks are only accepted for exact hostnames listed here.
CALLBACK_ALLOWED_HOSTS=
CALLBACK_SIGNING_SECRET=dev-callback-signing-secret
CALLBACK_MAX_ATTEMPTS=5
CALLBACK_TIMEOUT_MS=10000
CALLBACK_CONCURRENCY=5

API_RATE_LIMIT_REQUESTS=600
API_RATE_LIMIT_WINDOW_MS=60000

# Set only when the app is behind a trusted reverse proxy that adds client IPs.
TRUST_PROXY_HOPS=0
